#version 450
#extension GL_ARB_separate_shader_objects : enable
precision highp float;
#extension GL_EXT_scalar_block_layout : enable
layout(set = 0, binding = 0) buffer OutIndirect {
  	uint indexCount;
  	uint instanceCount;
  	uint firstIndex;
  	int vertexOffset;
  	uint firstInstance;
}outIndirect;

layout(set = 0, binding = 1) buffer InIndirect {
  	uint indexCount;
  	uint instanceCount;
  	uint firstIndex;
  	int vertexOffset;
  	uint firstInstance;
}inIndirect;

struct MatrixData {
    mat4 protoMatrix;
    mat4 modelMatrix;
};

struct InstanceData {
    mat4 modelMatrix;
    vec4 highlight[10];
};

layout(set = 0, binding = 2) buffer InIndirectMatrix {
    MatrixData instanceModelMatrix[];
}inIndirectMatrix;

layout(set = 0, binding = 3) buffer InHighlightData {
    uvec4 data[];
}inHighlightData;

layout(set = 0, binding = 4) buffer OutIndirectMatrix {
    InstanceData instanceModelMatrix[];
}outIndirectMatrix;

layout(set = 0, binding = 5) buffer CameraPlaneInfo{
	vec4 planes[6];
}camera_plane;

layout(std430, set = 0, binding = 6) buffer BBox{
    vec4 min;
    vec4 max;
    vec4 draw_state;
}bbox;

layout(set = 0, binding = 7) buffer ViewMatrix{
	mat4 view;
	mat4 vp;
}viewMatrix;

layout(set=0, binding = 8) uniform sampler2D mipPyramid;

layout (local_size_x = 32) in;

// 判断包围盒是否完全在视锥外（被某个平面完全遮挡）
bool isFullyCulled(vec4[8] points, vec4 plane) {
    for (int i = 0; i < 8; i++) {
        if (dot(points[i].xyz, plane.xyz) + plane.w >= 0.0) {
            return false; // 至少有一个点在平面内侧，未被完全遮挡
        }
    }
    return true; // 所有点都在平面外侧，完全被遮挡
}

// 全局配置：输出表面分辨率（固定为 2x2）
const vec2 surface_size = vec2(2.0f);
// 输出数组：存储 2x2 像素的最大深度（uint 类型，对应 float 转二进制）
// 数组索引规则：index = y * 2 + x（x/y 为 0 或 1，对应 2x2 像素坐标）

float sub_sample_count = 3;

void rasterize(vec3 p0, vec3 p1, vec3 p2, inout float out_surface[4]) {
    // 剔除任一顶点深度<0的三角形（超出近平面）
    if (p0.z < 0.0f || p1.z < 0.0f || p2.z < 0.0f) return;

    vec3 p10 = p1 - p0;
    vec3 p20 = p2 - p0;
    float det = p20.x * p10.y - p20.y * p10.x;
    // 剔除顺时针绕组的三角形（仅处理逆时针三角形）
    if (det >= 0.0f) return;

    // 计算三角形覆盖的像素范围（浮点数坐标）
    vec2 min_p = vec2(1 / (sub_sample_count * 2));
    vec2 max_p = surface_size - min_p;

    // 计算重心坐标的微分（用于逐像素快速计算）
    vec2 texcoord_dx = vec2(-p20.y, p10.y) / det;
    vec2 texcoord_dy = vec2(p20.x, -p10.x) / det;

    // 初始化起始像素的重心坐标
    vec2 texcoord_x = texcoord_dx * (min_p.x - p0.x);
    vec2 texcoord_y = texcoord_dy * (min_p.y - p0.y);

    // 逐行逐像素遍历覆盖区域（仅遍历 0/1 两个像素坐标）
    for (float y = min_p.y; y <= max_p.y; y += 1 / sub_sample_count) {
        vec2 texcoord = texcoord_x + texcoord_y;
        for (float x = min_p.x; x <= max_p.x; x += 1 / sub_sample_count) {
            // 判断像素是否在三角形内部（重心坐标有效性）
            if (texcoord.x >= 0.0f && texcoord.y >= 0.0f && texcoord.x + texcoord.y <= 1.0f) {
                // 重心坐标插值计算当前像素的深度值
                float z = p10.z * texcoord.x + p20.z * texcoord.y + p0.z;
                
                // 计算数组索引：2x2 像素 → index = y*2 + x（x/y 取整后为 0 或 1）
                uint x_idx = uint(x);
                uint y_idx = uint(y);
                uint index = y_idx * 2u + x_idx;
                
                // 原子操作：保留该像素的最大深度（避免多三角形覆盖时的竞争问题）
                out_surface[index] = max(out_surface[index], z);
            }
            // 沿x方向更新重心坐标
            texcoord += texcoord_dx / sub_sample_count;
        }
        // 沿y方向更新重心坐标
        texcoord_y += texcoord_dy / sub_sample_count;
    }
}

float compare_image_size = 2;

void main() {
	uint instanceIndex = gl_GlobalInvocationID.x;
    
    // 确保不超出实例数量范围
    if (instanceIndex >= inIndirect.instanceCount) {
        return;
    }

	// 初始化输出
    if (gl_LocalInvocationID.x == 0 && gl_WorkGroupID.x == 0) {
        outIndirect.instanceCount = 0; // 默认不可见
    }
    barrier(); // 确保初始化完成
    inHighlightData.data[instanceIndex].z = 0;

    // 计算包围盒的8个顶点（世界空间）
    vec4 points[8];
    points[0] = vec4(bbox.min.x, bbox.min.y, bbox.min.z, 1.0);
    points[1] = vec4(bbox.min.x, bbox.min.y, bbox.max.z, 1.0);
    points[2] = vec4(bbox.min.x, bbox.max.y, bbox.min.z, 1.0);
    points[3] = vec4(bbox.min.x, bbox.max.y, bbox.max.z, 1.0);
    points[4] = vec4(bbox.max.x, bbox.min.y, bbox.min.z, 1.0);
    points[5] = vec4(bbox.max.x, bbox.min.y, bbox.max.z, 1.0);
    points[6] = vec4(bbox.max.x, bbox.max.y, bbox.min.z, 1.0);
    points[7] = vec4(bbox.max.x, bbox.max.y, bbox.max.z, 1.0);

	mat4 mv = viewMatrix.view * 
					inIndirectMatrix.instanceModelMatrix[instanceIndex].modelMatrix * 
					inIndirectMatrix.instanceModelMatrix[instanceIndex].protoMatrix;
	mat4 mvp = viewMatrix.vp * 
					inIndirectMatrix.instanceModelMatrix[instanceIndex].modelMatrix * 
					inIndirectMatrix.instanceModelMatrix[instanceIndex].protoMatrix;
    vec4 viewPoints[8];
    vec4 clipPoints[8];


	for(int i = 0; i < 8; i ++){
		viewPoints[i] = mv * points[i];
		clipPoints[i] = mvp * points[i];
	}


    // 检查是否被任一平面完全遮挡
    bool culled = false;
    for (int p = 0; p < 6; p++) {
        if (isFullyCulled(viewPoints, camera_plane.planes[p])) {
            culled = true;
            break;
        }
    }

    // 如果没有被完全遮挡，则设置实例可见
    if (!culled) {		
        ivec2 imageSize = ivec2(1280, 960);

        vec3 uv_min = vec3(100.0);
        vec3 uv_max = vec3(-100.0);
        vec3 ndcs[8];
        for (int i = 0; i < 8; i++) {
            ndcs[i] = clipPoints[i].xyz / clipPoints[i].w;
            ndcs[i].xy = clamp(ndcs[i].xy, -1, 1) * 0.5 + 0.5;
            ndcs[i].z = clamp(ndcs[i].z, 0, 1);
            uv_min.x = min(uv_min.x, ndcs[i].x);
            uv_min.y = min(uv_min.y, ndcs[i].y);
            uv_min.z = min(uv_min.z, ndcs[i].z);
            uv_max.x = max(uv_max.x, ndcs[i].x);
            uv_max.y = max(uv_max.y, ndcs[i].y);
            uv_max.z = max(uv_max.z, ndcs[i].z);
        }
        float x_bound = (uv_max.x - uv_min.x);
        float y_bound = (uv_max.y - uv_min.y);
        float uvWidth  = x_bound * imageSize.x;   // 物体在纹理空间覆盖的宽度（像素）
        float uvHeight = y_bound * imageSize.y;  // 物体在纹理空间覆盖的高度（像素）

        // 计算Mip Level（取最大边长的对数）
        float maxCoverage = max(uvWidth, uvHeight);
        int mipLevel = int(floor(log2(maxCoverage)));
        mipLevel = clamp(mipLevel, 0, 8);

        float level_lower = float(max(mipLevel - 1, 0)); 
        float scale = pow(2.0, -level_lower);
        ivec2 a = ivec2(floor(uv_min.xy * scale * imageSize));  // 起始像素坐标（向下取整后转整数）
        ivec2 b = ivec2(floor(uv_max.xy * scale * imageSize)) + 1;  // 结束像素坐标（向下取整+1，转整数）
        ivec2 dims = b - a;  // 整数类型的尺寸（单位：像素）
        if (dims.x <= 2 && dims.y <= 2)
            mipLevel = int(level_lower);
        scale = pow(2.0, -mipLevel);
        a = ivec2(floor(uv_min.xy * scale * imageSize));  // 起始像素坐标（向下取整后转整数）
        b = ivec2(ceil(uv_max.xy * scale * imageSize));  // 结束像素坐标（向下取整+1，转整数）

        float bbox_depth_grid[4] = float[4](0.0, 0.0, 0.0, 0.0);
        InstanceData out_data;
        for(int i = 0; i < 8; ++i){
            ivec2 delta = ivec2(floor(ndcs[i].xy * scale * imageSize) - a);
            int index = delta.y * 2 + delta.x;
            index = max(min(3, index), 0);
            bbox_depth_grid[index] = max(bbox_depth_grid[index], ndcs[i].z);
        }

        vec2 scale1 = imageSize / pow(2.0, mipLevel);
        bool depth_culled = false;
        vec2 mipUV0 = (vec2(a.x + 0.5f, a.y + 0.5f)) / scale1;
        vec2 mipUV1 = (vec2(a.x + 0.5f, a.y + 1.5f)) / scale1;
        vec2 mipUV2 = (vec2(a.x + 1.5f, a.y + 0.5f)) / scale1;
        vec2 mipUV3 = (vec2(a.x + 1.5f, a.y + 1.5f)) / scale1;
        float render_depth0 = textureLod(mipPyramid, mipUV0, mipLevel).x;
        float render_depth1 = textureLod(mipPyramid, mipUV1, mipLevel).x;
        float render_depth2 = textureLod(mipPyramid, mipUV2, mipLevel).x;
        float render_depth3 = textureLod(mipPyramid, mipUV3, mipLevel).x;

        vec3 screenPoints[8];
        for (int i = 0; i < 8; i++) {
            screenPoints[i].xy = ndcs[i].xy * scale * imageSize - a;
            screenPoints[i].z = ndcs[i].z;
        }
        float out_surface[4] = float[4](0, 0, 0, 0);
        rasterize(screenPoints[0], screenPoints[2], screenPoints[6], out_surface); // 三角形 0-2-6（逆时针）
        rasterize(screenPoints[0], screenPoints[6], screenPoints[4], out_surface); // 三角形 0-6-4（逆时针）
        rasterize(screenPoints[1], screenPoints[5], screenPoints[7], out_surface); // 三角形 1-5-7（逆时针）
        rasterize(screenPoints[1], screenPoints[7], screenPoints[3], out_surface); // 三角形 1-7-3（逆时针）
        rasterize(screenPoints[0], screenPoints[1], screenPoints[3], out_surface); // 三角形 0-1-3（逆时针）
        rasterize(screenPoints[0], screenPoints[3], screenPoints[2], out_surface); // 三角形 0-3-2（逆时针）
        rasterize(screenPoints[4], screenPoints[6], screenPoints[7], out_surface); // 三角形 4-6-7（逆时针）
        rasterize(screenPoints[4], screenPoints[7], screenPoints[5], out_surface); // 三角形 4-7-5（逆时针）
        rasterize(screenPoints[0], screenPoints[4], screenPoints[5], out_surface); // 三角形 0-4-5（逆时针）
        rasterize(screenPoints[0], screenPoints[5], screenPoints[1], out_surface); // 三角形 0-5-1（逆时针）
        rasterize(screenPoints[2], screenPoints[3], screenPoints[7], out_surface); // 三角形 2-3-7（逆时针）
        rasterize(screenPoints[2], screenPoints[7], screenPoints[6], out_surface); // 三角形 2-7-6（逆时针）

        float theta = 0.000001;
        out_data.highlight[8].x = out_surface[0];
        out_data.highlight[8].y = out_surface[1];
        out_data.highlight[8].z = out_surface[2];
        out_data.highlight[8].w = out_surface[3];

        for(int i = 0; i < 4; ++i){
            out_surface[i] = max(out_surface[i], bbox_depth_grid[i]);
        }
        if(out_surface[0] - theta <= render_depth0 
            && out_surface[1] - theta <= render_depth1 
            && out_surface[2]  - theta<= render_depth2 
            && out_surface[3]  - theta<= render_depth3)
            depth_culled = true;
        out_data.highlight[5].xyz = uv_min;
        out_data.highlight[6].xyz = uv_max;
        out_data.highlight[7].x = bbox_depth_grid[0];
        out_data.highlight[7].y = bbox_depth_grid[1];
        out_data.highlight[7].z = bbox_depth_grid[2];
        out_data.highlight[7].w = bbox_depth_grid[3];
        out_data.highlight[9].x = render_depth0;
        out_data.highlight[9].y = render_depth1;
        out_data.highlight[9].z = render_depth2;
        out_data.highlight[9].w = render_depth3;

        for(int i = 2; i < 10; ++i){
            out_data.highlight[i].xyz = screenPoints[i - 2] + vec3(a, 0);
        }
        out_data.highlight[9].w = mipLevel;
        if(!depth_culled){
            inHighlightData.data[instanceIndex].z = 1;
            if(inHighlightData.data[instanceIndex].y == 0){
                uint prevCount = atomicAdd(outIndirect.instanceCount, 1);
                MatrixData cur_data = inIndirectMatrix.instanceModelMatrix[instanceIndex];
                out_data.modelMatrix = cur_data.modelMatrix * cur_data.protoMatrix;
                out_data.highlight[0].x = inHighlightData.data[instanceIndex].x;
                outIndirectMatrix.instanceModelMatrix[prevCount] = out_data;
    
                memoryBarrierBuffer();	
            }
        }
    }
}
