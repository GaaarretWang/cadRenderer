// ============================================================================
// Fullscreen Quad Vertex Shader（全屏四边形顶点着色器）
// ============================================================================
// 作用：无需顶点缓冲，仅通过gl_VertexIndex自动生成覆盖全屏的三角形。
//       这是一个经典的"无顶点缓冲"全屏三角形技术：
//       3个顶点索引(0,1,2)自动映射到屏幕空间的三个角，
//       GPU光栅化后覆盖整个屏幕。
// 流水线角色：用于SSAO、去噪等需要全屏处理的后处理阶段。
//             输出UV坐标[0,1]供fragment shader采样纹理。
// ============================================================================

#version 450

layout (location = 0) out vec2 outUV; // 输出UV坐标（范围[0,1]）

void main()
{
	// 位运算技巧：通过gl_VertexIndex生成覆盖全屏的UV坐标
	// gl_VertexIndex: 0->(0,0), 1->(2,0), 2->(0,2)
	// 映射到NDC后：(-1,-1), (3,-1), (-1,3)，形成覆盖全屏的大三角形
	outUV = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
	// 将[0,2]范围的UV映射到[-1,1]的NDC裁剪空间
	gl_Position = vec4(outUV * 2.0f - 1.0f, 0.0f, 1.0f);
}
